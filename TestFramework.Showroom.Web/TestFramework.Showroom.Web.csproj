<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>

		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
	</PropertyGroup>

	<!-- The Docker gate is one file for every lane that needs a daemon, so one machine is judged one way. -->
	<ItemGroup>
		<Compile Include="..\Shared\ShowroomEnvironmentGate.cs" Link="ShowroomEnvironmentGate.cs" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="coverlet.collector" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" />
		<PackageReference Include="TestFramework.Config" />
		<PackageReference Include="TestFramework.Container.Web" />
		<PackageReference Include="TestFramework.Core" />
		<PackageReference Include="TestFramework.Web" />
		<PackageReference Include="xunit" />
		<PackageReference Include="xunit.runner.visualstudio" />
	</ItemGroup>

	<!--
		There is deliberately no reference to Web/OrdersApi here.

		The application under test is named by its project file, not by a type, so the
		test assembly never loads a single line of it. That is not an oversight and it
		is not laziness; it is the only arrangement in which "the test does not know
		how the application works" is a fact rather than a pleasant belief.
	-->

	<ItemGroup>
		<Using Include="Xunit" />
	</ItemGroup>

</Project>
