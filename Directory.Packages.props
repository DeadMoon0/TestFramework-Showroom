<Project>

	<!--
		One version per package for the whole solution.

		Before this file the three lanes pinned three different Core versions (0.1.8, 0.1.9, 0.1.8),
		which is how the web lane's unrestorable references stayed invisible: nothing in the build
		compared them. Versions now live here and nowhere else, so a mismatch is impossible to write.

		CentralPackageTransitivePinningEnabled keeps a transitive dependency from quietly pulling in
		an older Core than the one declared here.

		The rule for this file is that every version below is published on nuget.org: the showroom is
		what a stranger clones first, so it must restore from the public feed alone. If a version here
		is not published, a fresh clone fails - which is exactly how the web lane once shipped
		references to a Core and a Config that existed only in a local feed.

		THE RULE IS CURRENTLY BROKEN, ON PURPOSE, AND HERE IS THE LIST. The structural-fix
		train changed the step contract, so the showroom's own custom steps and environment components
		had to move with it, and that needs versions the feed does not have yet. Nine of the eleven
		pins below are ahead of what is published:

		  Core            0.3.0 published, 0.4.0 pinned
		  Config          0.2.1 published, 0.3.0 pinned
		  Simple          0.2.1 published, 0.3.0 pinned
		  Azure           0.3.0 published, 0.4.0 pinned
		  LocalIO         0.3.0 published, 0.4.0 pinned
		  Container       0.3.0 published, 0.4.0 pinned
		  Container.Azure 0.3.0 published, 0.4.0 pinned
		  Container.Web   0.3.0 published, 0.4.0 pinned
		  UI.Browser      never published, 0.2.0 pinned
		  UI.Web          never published, 0.2.0 pinned
		  Web             0.4.0 published, 0.4.0 pinned  (the one that is already fine)

		Until those are released, a fresh clone of this repository alone does not restore. It builds
		here because the working tree above it carries a NuGet.config with a local feed
		(artifacts/nuget-local). Release order is dependency order: Core, Simple, Config, LocalIO,
		Azure, Web, Container, Container.Azure, Container.Web, then the UI trio - and nothing else in
		this file needs touching once they are on the feed, because the numbers are already the ones
		that will be published. Nothing here is a placeholder.
	-->

	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
		<CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
	</PropertyGroup>

	<ItemGroup Label="TestFramework">
		<PackageVersion Include="TestFramework.Azure" Version="0.4.0" />
		<PackageVersion Include="TestFramework.Config" Version="0.3.0" />
		<PackageVersion Include="TestFramework.Container" Version="0.4.0" />
		<PackageVersion Include="TestFramework.Container.Azure" Version="0.4.0" />
		<PackageVersion Include="TestFramework.Container.Web" Version="0.4.0" />
		<PackageVersion Include="TestFramework.Core" Version="0.4.0" />
		<PackageVersion Include="TestFramework.LocalIO" Version="0.4.0" />
		<PackageVersion Include="TestFramework.Simple" Version="0.3.0" />
		<PackageVersion Include="TestFramework.UI.Browser" Version="0.2.0" />
		<PackageVersion Include="TestFramework.UI.Web" Version="0.2.0" />
		<PackageVersion Include="TestFramework.Web" Version="0.4.0" />
	</ItemGroup>

	<ItemGroup Label="Test host">
		<PackageVersion Include="coverlet.collector" Version="6.0.0" />
		<PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
		<PackageVersion Include="xunit" Version="2.5.3" />
		<PackageVersion Include="xunit.runner.visualstudio" Version="2.5.3" />
	</ItemGroup>

	<ItemGroup Label="Applications under test">
		<PackageVersion Include="Azure.Data.Tables" Version="12.9.1" />
		<PackageVersion Include="Microsoft.ApplicationInsights.WorkerService" Version="2.23.0" />
		<!-- 3.59.0, not the 3.57.1 the Function App used to pin: TestFramework.Azure 0.2.0 needs
		     at least 3.59.0, and one central version means the higher floor wins for both. -->
		<PackageVersion Include="Microsoft.Azure.Cosmos" Version="3.59.0" />
		<PackageVersion Include="Microsoft.Azure.Functions.Worker" Version="2.1.0" />
		<PackageVersion Include="Microsoft.Azure.Functions.Worker.ApplicationInsights" Version="2.0.0" />
		<PackageVersion Include="Microsoft.Azure.Functions.Worker.Extensions.Http.AspNetCore" Version="2.0.2" />
		<PackageVersion Include="Microsoft.Azure.Functions.Worker.Extensions.ServiceBus" Version="5.24.0" />
		<PackageVersion Include="Microsoft.Azure.Functions.Worker.Extensions.Timer" Version="4.3.1" />
		<PackageVersion Include="Microsoft.Azure.Functions.Worker.Sdk" Version="2.0.5" />
		<PackageVersion Include="Microsoft.Data.SqlClient" Version="6.1.2" />
		<PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
	</ItemGroup>

</Project>
