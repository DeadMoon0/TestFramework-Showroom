<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>

		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
	</PropertyGroup>

	<!-- The Docker gate is one file for every lane that needs a daemon, so one machine is judged one way. -->
	<ItemGroup>
		<Compile Include="..\Shared\ShowroomEnvironmentGate.cs" Link="ShowroomEnvironmentGate.cs" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="coverlet.collector" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" />
		<PackageReference Include="TestFramework.Azure" />
		<PackageReference Include="TestFramework.Azure.Functions" />
		<PackageReference Include="TestFramework.Config" />
		<PackageReference Include="TestFramework.Container.Azure" />
		<PackageReference Include="TestFramework.Core" />
		<PackageReference Include="xunit" />
		<PackageReference Include="xunit.runner.visualstudio" />
	</ItemGroup>

	<!-- Unlike the Web lane, which reaches its API only by path: the Cosmos container is declared from the
	     application's model type (DockerCosmosDbDefinition<CandidateProfile>), and that type lives here. -->
	<ItemGroup>
		<ProjectReference Include="..\Azure\FunctionApp\FunctionApp.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="Xunit" />
	</ItemGroup>

</Project>
